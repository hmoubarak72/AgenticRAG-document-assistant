# ---- LLM (Groq) -----------------------------------------------------------
# Get a key at https://console.groq.com. Leave empty to run in offline mode
# (heuristic routing + extractive answers) for UI/ingestion testing.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional faster model for planning/grading (defaults to LLM_MODEL), e.g.:
# ROUTER_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1

# ---- Qdrant ---------------------------------------------------------------
# Leave QDRANT_URL empty to use embedded on-disk Qdrant (no Docker needed).
# Docker:        QDRANT_URL=http://localhost:6333
# Qdrant Cloud:  QDRANT_URL=https://<cluster>.cloud.qdrant.io  + QDRANT_API_KEY
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=agenticrag_documents

# ---- Embeddings -----------------------------------------------------------
# fastembed runs locally on CPU (model downloads once, ~130 MB).
# Changing the model changes vector size: use a new QDRANT_COLLECTION.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Ingestion & agent ----------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
MAX_RETRIEVAL_ATTEMPTS=2
HISTORY_TURNS=6
# Search the library before answering directly, so any question about your documents is answered from them
PROBE_LIBRARY=true
MAX_UPLOAD_MB=30

# ---- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
